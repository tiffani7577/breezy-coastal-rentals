{
  "buildCommand": "pnpm build",
  "outputDirectory": "client/dist",
  "installCommand": "pnpm install",
  "functions": {
    "api/dist/index.mjs": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/dist/index.mjs" }
  ],
  "env": {
    "NODE_ENV": "production",
    "VERCEL_SKIP_TYPESCRIPT_CHECK": "1"
  }
}
